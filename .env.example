# ══════════════════════════════════════════════════════════════
# KaamSetu Environment Variables
# ══════════════════════════════════════════════════════════════

# Supabase PostgreSQL Configuration
# Note: KaamSetu includes a complete client/mock storage fallback that operates 100% interactively
# out-of-the-box without credentials. Supply your Supabase keys below for live cloud sync.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Razorpay Payment Gateway (Optional - for future escrow or digital advances)
# By default, KaamSetu operates on a 0% commission direct-to-worker settlement via UPI/Cash on completion.
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret

# Geocoding / Maps Provider (Optional)
NEXT_PUBLIC_MAPS_API_KEY=placeholder_maps_key

# SMS / OTP Provider (Optional - Demo mode provides instant mock OTP: 123456)
SMS_GATEWAY_API_KEY=placeholder_sms_key
