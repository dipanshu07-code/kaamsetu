# ══════════════════════════════════════════════════════════════
# KaamSetu environment variables
# Copy to .env.local for local development. Never commit real values.
# ══════════════════════════════════════════════════════════════

# --- Database -------------------------------------------------
# Production: Postgres connection string (e.g. Supabase → Project Settings → Database → Connection string).
# The app connects from the server only. Leave empty to use the embedded local database (PGlite).
DATABASE_URL=
# Set to "false" only if your Postgres does not use TLS (e.g. a local Postgres).
DATABASE_SSL=
DATABASE_POOL_MAX=10
# Apply migrations automatically on start when using DATABASE_URL (otherwise run `npm run db:migrate`).
KAAMSETU_AUTO_MIGRATE=false

# Local embedded database directory (only used when DATABASE_URL is empty). "memory" = not persisted.
KAAMSETU_PGLITE_DIR=.data/pglite

# --- Demo data ------------------------------------------------
# Seeds clearly-labelled demo accounts, workers and jobs. Defaults to ON for local PGlite and OFF with DATABASE_URL.
# NEVER enable on a public production database: demo accounts (including an admin) share one password.
KAAMSETU_DEMO_SEED=
KAAMSETU_DEMO_PASSWORD=demo-pass-123

# --- Cookies --------------------------------------------------
# Session cookies are Secure in production. Set to "false" only to test `next start` over plain http locally.
COOKIE_SECURE=

# --- Not yet integrated (documented integration points) -------
# Identity / background verification provider. No provider is integrated; checks are recorded manually by admins.
VERIFICATION_PROVIDER=
# SMS / OTP provider. Not integrated; login uses mobile number + password.
SMS_GATEWAY_API_KEY=
# Payments are settled directly (cash/UPI). No payment gateway is integrated.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
